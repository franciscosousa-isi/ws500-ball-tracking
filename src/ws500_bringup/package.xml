<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ws500_bringup</name>
  <version>0.0.1</version>
  <description>Launch files e configuracao de integracao (MAVROS, camera Orbbec, lidar YDLidar) para o desafio de rastreamento de bola do WS500</description>
  <maintainer email="erberto.biteduc@gmail.com">ws500dev</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>mavros</exec_depend>
  <exec_depend>ws500_perception</exec_depend>
  <exec_depend>ws500_control</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
